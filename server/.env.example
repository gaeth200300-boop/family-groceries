# ---- runtime ----
NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Path to the SQLite file, or :memory: for tests
DATABASE_URL=./data/app.db

# REQUIRED. At least 32 characters of random text.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this signs everyone out.
JWT_SECRET=change-me-change-me-change-me-change-me32

# Session length.
#
# ACCESS_TOKEN_TTL is short-lived by design: it is never written to the device and
# is silently renewed using the refresh token below.
#
# REFRESH_TOKEN_TTL_DAYS is a SLIDING window. The refresh token is single-use and
# rotated on every refresh, with its expiry reset from that moment. A member who
# opens the app at least once a year therefore never has to sign in again.
# 365 (one year) is the default and is what a family app wants. Raise to 3650
# (ten years) if you would rather never think about it.
#
# This does NOT weaken revocation: disabling or deleting a member kills every one
# of their sessions immediately, whatever this is set to.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=365

# Comma-separated browser origins allowed to call the API.
# Leave empty when only the packaged iOS app talks to it.
CORS_ORIGINS=

# Set to true when running behind a TLS-terminating proxy.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# FIRST-RUN SETUP
# ---------------------------------------------------------------------------
# One-time secret that authorises creating the very first (owner) account.
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# With this set, REQUIRE_INVITE can stay true FOREVER. Anyone who reaches
# /api/auth/register without a valid setup token is refused, and the token
# stops mattering the moment the first account exists.
#
# If you leave it unset AND set REQUIRE_INVITE=false, you have reopened a race:
# whoever registers first becomes the owner. Do not do that on a public URL.
SETUP_TOKEN=

# true  = an invite code is required to register (correct for production)
# false = legacy bootstrap path, only safe together with SETUP_TOKEN above
REQUIRE_INVITE=true

# Throttle on /api/auth/login, /register, /change-password (per IP)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# WEB PUSH (notifications on the phone)
# ---------------------------------------------------------------------------
# Leave both keys empty to generate a VAPID pair on first boot and store it in
# server/data/vapid.json (git-ignored). Set both when running several replicas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@family.home
