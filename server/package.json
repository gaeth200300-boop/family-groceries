{
  "name": "family-groceries-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the Family Groceries (مقاضي العائلة) iOS app — invite-only auth, per-household authorisation",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "create-owner": "node scripts/create-owner.js",
    "verify-deployment": "node scripts/verify-deployment.js",
    "device-readiness": "node scripts/device-readiness.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@peculiar/x509": "^2.1.0",
    "jsdom": "^30.1.1",
    "reflect-metadata": "^0.2.2"
  }
}
